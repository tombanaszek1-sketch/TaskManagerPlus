<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Machine-wide installer. The app needs administrator rights at runtime anyway, and installing
    per machine lets the uninstaller remove the elevated logon task the app may have created.
  -->
  <Package Name="Task Manager+"
           Manufacturer="Task Manager+ contributors"
           Version="$(Version)"
           UpgradeCode="{B22992D4-5D39-4BF8-902D-E2DFDECF168A}"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\src\TaskManagerPlus\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/tombanaszek1-sketch/TaskManagerPlus" />
    <Property Id="ARPHELPLINK" Value="https://github.com/tombanaszek1-sketch/TaskManagerPlus/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Task Manager+" />
    </StandardDirectory>

    <Feature Id="Main" Title="Task Manager+">
      <Component Id="App" Directory="INSTALLFOLDER" Guid="*">
        <File Id="AppExe" Source="$(PublishDir)TaskManagerPlus.exe" KeyPath="yes" />
        <File Id="License" Source="..\LICENSE" Name="LICENSE.txt" />
        <File Id="ThirdPartyNotices" Source="..\THIRD-PARTY-NOTICES.txt" />
      </Component>

      <!-- Official PawnIO installer (GPL-2.0) for CPU temperatures and mainboard sensors. -->
      <Component Id="SensorDriverSetup" Directory="INSTALLFOLDER" Guid="*">
        <File Id="PawnIOSetup" Source="$(ThirdPartyDir)PawnIO_setup.exe" KeyPath="yes" />
      </Component>

      <!-- Shortcuts live in their own components, keyed by a small registry value as Windows Installer requires. -->
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="Task Manager+"
                  Description="See which programs use your CPU, GPU, memory, disks and network"
                  Target="[INSTALLFOLDER]TaskManagerPlus.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\TaskManagerPlus" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="Task Manager+"
                  Target="[INSTALLFOLDER]TaskManagerPlus.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\TaskManagerPlus" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- The app can register an elevated logon task; remove it when the app is uninstalled (not on upgrades). -->
    <CustomAction Id="RemoveStartupTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /Delete /F /TN &quot;Task Manager+&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Installs the sensor driver silently so CPU temperatures work right away. The driver is shared with
      other monitoring tools and has its own uninstall entry, so it is left in place on uninstall.
    -->
    <CustomAction Id="InstallSensorDriver"
                  FileRef="PawnIOSetup"
                  ExeCommand="-install -silent"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveStartupTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="InstallSensorDriver" After="InstallFiles" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
